# --- Supabase (veritabanı + Google ile giriş) ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Gizli anahtar (Project Settings → API Keys → Secret keys). YALNIZCA sunucuda kullanılır;
# asla NEXT_PUBLIC_ ile başlatma ve git'e koyma. Veritabanı fonksiyonları (odt_*) bununla çağrılır.
SUPABASE_SECRET_KEY="sb_secret_..."

# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Google girişi Supabase'de yapılandırılır (Authentication → Providers → Google);
# GOOGLE_CLIENT_ID / SECRET bu uygulamada artık gerekmez.
# Süper yönetici (ilk girişte otomatik oluşturulur) ve giriş yapabilecek hesaplar:
ODT_SUPER_EMAIL="ulukan@northfly.aero"
ODT_ALLOWED_EMAIL_DOMAINS="northfly.aero"
ODT_ALLOWED_EMAILS=""

# WordPress forms and SEO (required for the daily SEO cron).
WP_BASE_URL="https://northfly.aero/wp-json"
WP_USER=""
WP_APP_PASSWORD=""

# WhatsApp / Desk360
DESK360_API_TOKEN=""
DESK360_DEFAULT_INTEGRATION_ID="2247"

# Verimor: Santral Ayarlarım → API Anahtarı
VERIMOR_API_KEY=""
VERIMOR_API_BASE="https://api.bulutsantralim.com"

# Naeron REST BI v2 (https://naeron.com/docs/restBI/): öğrenci, sözleşme, ödeme ve uçuş verisi buradan eşitlenir.
NAERON_API_KEY=""
NAERON_API_BASE="https://api.naeron.com:3110/v2"

# Varsayılan kurumsal etiket filtresi (virgüllü Naeron etiket ID listesi). Tanımsız = Northfly varsayılanları; boş = filtre yok.
# NEXT_PUBLIC_ODT_DEFAULT_CORP_LABEL_IDS=""
